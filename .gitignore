# Rust build artifacts (also covered by backend/.gitignore)
/backend/target/

# Node / Vite (also covered by frontend/.gitignore)
/frontend/node_modules/
/frontend/dist/

# Runtime SQLite database + WAL sidecars (do not commit data)
*.db
*.db-wal
*.db-shm

# Local environment overrides — commit .env.example, not the real .env
.env
.env.local
!.env.example

# OS / editor cruft
.DS_Store
*.log

# Internal planning/design docs — kept local, not published
/doc/
/proposal.md
